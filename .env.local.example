# Copy this file to .env.local and fill values. Do NOT commit .env.local

# Credentials used by the admin UI (used by /api/admin/login)
ADMIN_USER=admin
ADMIN_PASS=change_this_to_a_strong_password

# HMAC secret used to sign admin session tokens (use a long random value)
# You can generate a 32-byte hex secret with the provided script in scripts/
ADMIN_SECRET=replace_with_generated_secret

# BasicAuth protecting /admin and /api/admin (middleware)
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=change_this_to_a_strong_password

# Node environment
NODE_ENV=development
